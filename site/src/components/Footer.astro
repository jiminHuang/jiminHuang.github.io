---
import Meander from "./Meander.astro";

const cols = [
  {
    title: "Research",
    links: [
      { label: "Active projects", href: "/research#active" },
      { label: "Project archive", href: "/research#archive" },
      { label: "Publications", href: "/publications" },
    ],
  },
  {
    title: "Tools",
    links: [
      { label: "TerMine", href: "/tools/termine" },
      { label: "Argo", href: "/tools/argo" },
      { label: "U-Compare", href: "/tools/u-compare" },
      { label: "EventMine", href: "/tools/eventmine" },
      { label: "Thalia", href: "/tools/thalia" },
      { label: "All tools", href: "/tools" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Corpora", href: "/resources" },
      { label: "GENIA", href: "/resources/genia" },
      { label: "PHAEDRA", href: "/resources/phaedra" },
      { label: "Bio-Lexicon", href: "/resources/bio-lexicon" },
    ],
  },
  {
    title: "About",
    links: [
      { label: "People", href: "/people" },
      { label: "Press", href: "/news#press" },
      { label: "Seminars", href: "/news#seminars" },
      { label: "Contact", href: "mailto:nactem@manchester.ac.uk" },
    ],
  },
];
---

<footer class="border-t hairline bg-[color:var(--color-ink-950)] text-[color:var(--color-ink-100)] relative overflow-hidden">
  <div class="opacity-30">
    <Meander tone="amber" />
  </div>
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-10">
      <div class="col-span-2">
        <img src="/nactem-logo.png" alt="NaCTeM" class="h-9 w-auto mb-5 brightness-0 invert opacity-90" />
        <p class="serif text-base text-[color:var(--color-ink-300)] max-w-xs leading-relaxed">
          The world's first publicly-funded text-mining centre, hosted at the
          University of Manchester since <span class="antique italic">MMIV</span>.
        </p>
        <div class="mt-6 flex items-center gap-3 smallcaps text-[color:var(--color-ink-300)]">
          <span class="antique italic normal-case tracking-normal text-base text-[color:var(--color-amber-400)]">λόγος</span>
          <span class="opacity-50">·</span>
          <span>word · reason · text</span>
        </div>
      </div>
      {cols.map((col) => (
        <div>
          <div class="smallcaps text-[color:var(--color-ink-300)] mb-5">{col.title}</div>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="serif text-base text-[color:var(--color-ink-100)] hover:text-[color:var(--color-amber-400)] transition-colors">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 sans text-xs text-[color:var(--color-ink-300)]">
      <div>© {new Date().getFullYear()} National Centre for Text Mining · University of Manchester</div>
      <div class="flex gap-6">
        <a href="#" class="hover:text-[color:var(--color-paper)]">Terms</a>
        <a href="#" class="hover:text-[color:var(--color-paper)]">Privacy</a>
        <a href="#" class="hover:text-[color:var(--color-paper)]">Accessibility</a>
      </div>
    </div>
  </div>
</footer>
