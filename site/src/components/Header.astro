---
const nav = [
  { label: "Research", href: "/research" },
  { label: "Tools", href: "/tools" },
  { label: "Resources", href: "/resources" },
  { label: "People", href: "/people" },
  { label: "Publications", href: "/publications" },
  { label: "News", href: "/news" },
];
---

<header class="sticky top-0 z-40 backdrop-blur bg-[color:var(--color-paper)]/95 border-b hairline shadow-[0_1px_0_rgba(0,0,0,0.03),0_8px_24px_-12px_rgba(0,0,0,0.06)]">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-4">
      <img src="/nactem-logo.png" alt="NaCTeM — National Centre for Text Mining" class="h-9 md:h-10 w-auto" />
    </a>
    <nav class="hidden md:flex items-center gap-8 sans text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-[color:var(--color-ink-700)] hover:text-[color:var(--color-amber-600)] transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-search
        aria-label="Search"
        class="hidden sm:inline-flex items-center gap-2 sans text-sm text-[color:var(--color-ink-500)] border hairline rounded-full pl-3 pr-2 py-1.5 hover:border-[color:var(--color-ink-900)] hover:text-[color:var(--color-ink-900)] transition-colors"
      >
        <span aria-hidden>⌕</span>
        <span class="hidden lg:inline">Search</span>
        <kbd class="sans text-[10px] uppercase tracking-wider text-[color:var(--color-ink-500)] bg-[color:var(--color-paper-2)] border hairline rounded px-1.5 py-0.5">/</kbd>
      </button>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="hidden sm:inline-flex w-9 h-9 items-center justify-center border hairline rounded-full text-[color:var(--color-ink-700)] hover:text-[color:var(--color-ink-900)] hover:border-[color:var(--color-ink-900)] transition-colors text-sm"
      >
        <span class="dark:hidden" data-theme-light aria-hidden>☀</span>
        <span class="hidden" data-theme-dark aria-hidden>☾</span>
      </button>
      <a
        href="mailto:nactem@manchester.ac.uk"
        class="hidden sm:inline-flex items-center gap-1.5 sans text-sm font-medium text-[color:var(--color-ink-900)] border hairline rounded-full px-4 py-1.5 hover:bg-[color:var(--color-ink-900)] hover:text-[color:var(--color-paper)] hover:border-[color:var(--color-ink-900)] transition-colors"
      >
        Contact <span aria-hidden>→</span>
      </a>
      <button
        type="button"
        id="mobile-nav-toggle"
        class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 -mr-2"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <span class="block w-5 h-px bg-[color:var(--color-ink-900)] transition-all"></span>
        <span class="block w-5 h-px bg-[color:var(--color-ink-900)] transition-all"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-nav-drawer"
    class="md:hidden hidden border-t hairline bg-[color:var(--color-paper)]"
  >
    <nav class="px-6 py-4 flex flex-col gap-1 sans">
      {nav.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-[color:var(--color-ink-900)] hover:text-[color:var(--color-amber-600)] transition-colors text-base"
        >
          {item.label}
        </a>
      ))}
      <a
        href="mailto:nactem@manchester.ac.uk"
        class="block py-2 mt-2 border-t hairline pt-3 text-[color:var(--color-amber-600)] text-base"
      >
        Contact →
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("mobile-nav-toggle");
    const drawer = document.getElementById("mobile-nav-drawer");
    if (btn && drawer) {
      btn.addEventListener("click", () => {
        const open = drawer.classList.toggle("hidden") === false;
        btn.setAttribute("aria-expanded", String(open));
        btn.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      });
    }

    // Theme toggle
    const toggle = document.getElementById("theme-toggle");
    function applyTheme(name) {
      document.documentElement.classList.toggle("dark", name === "dark");
      document.querySelectorAll("[data-theme-light]").forEach((el) => el.classList.toggle("hidden", name === "dark"));
      document.querySelectorAll("[data-theme-dark]").forEach((el) => el.classList.toggle("hidden", name !== "dark"));
    }
    if (toggle) {
      toggle.addEventListener("click", () => {
        const current = document.documentElement.classList.contains("dark") ? "dark" : "light";
        const next = current === "dark" ? "light" : "dark";
        localStorage.setItem("theme", next);
        applyTheme(next);
      });
    }
  })();
</script>
