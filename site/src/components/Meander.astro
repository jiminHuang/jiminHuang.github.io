---
interface Props {
  tone?: "ink" | "paper" | "amber";
  class?: string;
}
const { tone = "ink", class: cls = "" } = Astro.props;

const stroke = {
  ink: "var(--color-ink-900)",
  paper: "var(--color-paper)",
  amber: "var(--color-amber-600)",
}[tone];
---

<!-- Greek meander (key) pattern, repeated horizontally. Decorative divider. -->
<svg
  aria-hidden="true"
  viewBox="0 0 80 16"
  preserveAspectRatio="xMidYMid meet"
  class={`block h-4 w-full ${cls}`}
  style={`color: ${stroke}`}
>
  <defs>
    <pattern id="meander" x="0" y="0" width="40" height="16" patternUnits="userSpaceOnUse">
      <path
        d="M0 14 L0 4 L8 4 L8 12 L4 12 L4 8 L20 8 L20 4 L12 4 L12 14 L28 14 L28 4 L36 4 L36 12 L32 12 L32 8 L40 8"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linejoin="miter"
      />
    </pattern>
  </defs>
  <rect width="100%" height="16" fill="url(#meander)" />
</svg>
