---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Meander from "../components/Meander.astro";
import SectionEyebrow from "../components/SectionEyebrow.astro";

const press = (await getCollection("press"))
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""))
  .slice(0, 4);

const allTools = await getCollection("tools");
const FEATURED_TOOLS = ["termine", "argo", "u-compare", "eventmine", "thalia", "robotanalyst"];
const tools = FEATURED_TOOLS
  .map((id) => allTools.find((t) => t.id === id))
  .filter(Boolean);

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => p.data.status === "Active")
  .sort((a, b) => (a.data.yearStart ?? 0) - (b.data.yearStart ?? 0));

const allPublications = await getCollection("publications");
const projectsCount = allProjects.length;
const pubsCount = allPublications.length;
const toolsCount = allTools.length;
const corporaCount = (await getCollection("corpora")).length;
const peopleCount = (await getCollection("people")).filter((p) => p.data.group !== "Alumni").length;
const formatPressDate = (iso?: string) => {
  if (!iso) return "";
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return iso;
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${months[parseInt(m[2]) - 1]} ${m[1]}`;
};

const stats = [
  { value: "MMIV", label: "Established" },
  { value: String(projectsCount), label: "Research projects" },
  { value: String(pubsCount), label: "Publications" },
  { value: String(toolsCount + corporaCount), label: "Open tools & corpora" },
];

const DOMAIN_CONFIG = [
  { greek: "Α", domain: "Biomedicine",   title: "Mining the biomedical literature",       body: "Extracting structured knowledge from millions of papers — genes, proteins, diseases, drug interactions — to accelerate discovery." },
  { greek: "Β", domain: "Public health", title: "Evidence at population scale",            body: "Surfacing actionable signals from clinical notes, systematic reviews, and surveillance data for the NHS, WHO, and partners." },
  { greek: "Γ", domain: "Biodiversity",  title: "Reading the natural world",               body: "Mining the Biodiversity Heritage Library and modern ecology corpora to map species, habitats, and historical change." },
  { greek: "Δ", domain: "Industry",      title: "Domain-tuned NLP, in production",         body: "Customised pipelines built with partners across pharma, finance, insurance, and government." },
];

const focusAreas = DOMAIN_CONFIG.map((d) => {
  const projectsInDomain = allProjects.filter((p) => p.data.domain === d.domain);
  const active = projectsInDomain.filter((p) => p.data.status === "Active").length;
  return {
    ...d,
    tag: d.domain,
    count: projectsInDomain.length,
    active,
    examples: projectsInDomain
      .sort((a, b) => (b.data.yearEnd ?? b.data.yearStart ?? 0) - (a.data.yearEnd ?? a.data.yearStart ?? 0))
      .slice(0, 3)
      .map((p) => ({ id: p.id, name: p.data.name })),
  };
});



const partners = [
  ["University of Manchester", "Host institution"],
  ["UKRI", "Research funder"],
  ["NIHR", "Health research"],
  ["European Commission", "EU collaborations"],
  ["AIRC, Japan", "Industrial AI"],
  ["BHF", "Cardiovascular"],
];
---

<Layout>
  <!-- HERO -->
  <section class="relative overflow-hidden paper-grain">
    <div class="absolute inset-0 -z-10">
      <div
        class="absolute -top-40 -right-40 w-[720px] h-[720px] rounded-full blur-3xl opacity-[0.10]"
        style="background: radial-gradient(closest-side, var(--color-amber-400), transparent 70%)"
      ></div>
      <div
        class="absolute -bottom-56 -left-32 w-[560px] h-[560px] rounded-full blur-3xl opacity-[0.06]"
        style="background: radial-gradient(closest-side, var(--color-amber-600), transparent 70%)"
      ></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-24 pb-28">
      <div class="flex items-center gap-3 smallcaps text-[color:var(--color-ink-500)] mb-10">
        <span class="w-2 h-2 rounded-full bg-[color:var(--color-amber-500)]"></span>
        <span>Est. MMIV · The University of Manchester</span>
        <span class="opacity-40">·</span>
        <span class="antique italic normal-case tracking-normal text-base text-[color:var(--color-amber-600)]">λόγος</span>
      </div>

      <h1 class="display text-[clamp(2.8rem,6.4vw,6rem)] font-normal leading-[1.05] tracking-[-0.01em] text-[color:var(--color-ink-900)] max-w-5xl">
        The world's first
        <em class="italic text-[color:var(--color-amber-600)]">publicly-funded</em>
        centre for <span class="whitespace-nowrap">text mining.</span>
      </h1>

      <p class="serif mt-10 text-xl md:text-2xl text-[color:var(--color-ink-700)] max-w-3xl leading-[1.55]">
        Founded in 2004 to help researchers cut through the
        <em>data deluge</em>, the <em>information overload</em>,
        and the <em>information overlook</em> — we build tools, corpora, and
        services that let you read at the scale of the modern literature.
      </p>

      <div class="mt-12 flex flex-wrap gap-3 sans">
        <a
          href="#research"
          class="inline-flex items-center gap-2 bg-[color:var(--color-ink-900)] text-[color:var(--color-paper)] rounded-full px-6 py-3 text-sm font-medium hover:bg-[color:var(--color-amber-600)] transition-colors"
        >
          Explore our research <span aria-hidden>→</span>
        </a>
        <a
          href="#tools"
          class="inline-flex items-center gap-2 border hairline text-[color:var(--color-ink-900)] rounded-full px-6 py-3 text-sm font-medium hover:bg-[color:var(--color-paper-2)] transition-colors"
        >
          Browse tools
        </a>
      </div>

      <div class="mt-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-[color:var(--color-ink-100)] border hairline rounded-2xl overflow-hidden">
        {stats.map((s) => (
          <div class="bg-[color:var(--color-paper)] p-6 md:p-8">
            <div class="display font-medium text-5xl md:text-6xl font-normal text-[color:var(--color-ink-900)] leading-none">{s.value}</div>
            <div class="mt-3 smallcaps text-[color:var(--color-ink-500)]">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Greek meander divider -->
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-6 opacity-50">
      <Meander tone="ink" />
    </div>
  </section>

  <!-- FOCUS AREAS -->
  <section id="research" class="border-t hairline bg-[color:var(--color-paper-2)]">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
      <div class="flex items-end justify-between mb-14 flex-wrap gap-4">
        <div>
          <SectionEyebrow letter="Ι" label="What we do" />
          <h2 class="display text-4xl md:text-6xl font-normal tracking-tight text-[color:var(--color-ink-900)] max-w-3xl leading-[1.05]">
            Four domains.
            <em class="italic text-[color:var(--color-amber-600)]">One method:</em>
            read everything, structure what matters.
          </h2>
        </div>
        <a href="/research" class="sans text-sm font-medium text-[color:var(--color-ink-900)] hover:text-[color:var(--color-amber-600)]">All research areas →</a>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-ink-100)] border hairline rounded-2xl overflow-hidden">
        {focusAreas.map((area) => (
          <article class="bg-[color:var(--color-paper)] p-8 md:p-10 group hover:bg-[color:var(--color-paper)]/60 transition-colors">
            <div class="flex items-center justify-between gap-3 mb-5">
              <div class="flex items-center gap-3">
                <span class="display italic font-normal text-3xl leading-none text-[color:var(--color-amber-600)]" aria-hidden="true">{area.greek}.</span>
                <span class="smallcaps text-[color:var(--color-ink-500)]">{area.tag}</span>
              </div>
              <div class="smallcaps text-[color:var(--color-ink-500)]">
                <span class="antique italic text-xl text-[color:var(--color-ink-900)] not-italic mr-1">{area.count}</span>
                {area.count === 1 ? "project" : "projects"}
                {area.active > 0 && <span class="text-[color:var(--color-amber-600)] ml-1">· {area.active} active</span>}
              </div>
            </div>
            <h3 class="display text-3xl font-normal text-[color:var(--color-ink-900)] mb-4 leading-snug">{area.title}</h3>
            <p class="serif text-[color:var(--color-ink-700)] leading-relaxed text-lg mb-5">{area.body}</p>
            {area.examples.length > 0 && (
              <ul class="flex flex-wrap gap-1.5">
                {area.examples.map((ex) => (
                  <li>
                    <a href={`/projects/${ex.id}`} class="inline-block smallcaps text-[color:var(--color-ink-500)] border hairline rounded-full px-2.5 py-1 hover:border-[color:var(--color-ink-900)] hover:bg-[color:var(--color-paper-2)] hover:text-[color:var(--color-ink-900)] transition-colors">
                      {ex.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section id="tools" class="border-t hairline">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
      <div class="grid md:grid-cols-[1fr_2fr] gap-12 mb-14">
        <div>
          <SectionEyebrow letter="ΙΙ" label="Tools" />
          <h2 class="display text-4xl md:text-6xl font-normal tracking-tight text-[color:var(--color-ink-900)] leading-[1.05]">
            Open infrastructure for <em class="italic text-[color:var(--color-amber-600)]">text mining.</em>
          </h2>
        </div>
        <p class="serif text-xl text-[color:var(--color-ink-700)] leading-[1.55] self-end max-w-2xl">
          Two decades of methods packaged as services, libraries, and
          interactive platforms — used in over 60 countries by clinicians,
          librarians, and computational researchers.
        </p>
      </div>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((t) => (
          <a href={`/tools/${t!.id}`} class="group block border hairline rounded-xl p-6 hover:border-[color:var(--color-ink-900)] hover:shadow-sm transition-all bg-[color:var(--color-paper)]">
            <div class="flex items-start justify-between mb-4">
              <span class="smallcaps text-[color:var(--color-ink-500)] bg-[color:var(--color-paper-2)] rounded-full px-2.5 py-1">{t!.data.tag}</span>
              <span class="text-[color:var(--color-ink-300)] group-hover:text-[color:var(--color-amber-600)] group-hover:translate-x-0.5 transition-all" aria-hidden>↗</span>
            </div>
            <div class="display text-3xl font-normal text-[color:var(--color-ink-900)] mb-2">{t!.data.name}</div>
            <p class="serif text-base text-[color:var(--color-ink-700)] leading-relaxed">{t!.data.tagline}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-right">
        <a href="/tools" class="sans text-sm font-medium text-[color:var(--color-ink-900)] hover:text-[color:var(--color-amber-600)]">All {toolsCount} tools →</a>
      </div>
    </div>
  </section>

  <!-- ACTIVE PROJECTS (dark) -->
  <section class="border-t hairline bg-[color:var(--color-ink-950)] text-[color:var(--color-paper)] relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 opacity-30">
      <Meander tone="amber" />
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
      <div class="flex items-end justify-between mb-14 flex-wrap gap-4">
        <div>
          <SectionEyebrow letter="ΙΙΙ" label="Active projects" tone="dark" />
          <h2 class="display text-4xl md:text-6xl font-normal tracking-tight max-w-2xl leading-[1.05]">
            Currently <em class="italic text-[color:var(--color-amber-400)]">in flight.</em>
          </h2>
        </div>
        <a href="/research" class="sans text-sm font-medium hover:text-[color:var(--color-amber-400)]">Project archive →</a>
      </div>

      <ul class="divide-y divide-white/10">
        {projects.map((p) => (
          <li class="group">
            <a href={`/projects/${p.id}`} class="py-7 grid grid-cols-12 gap-4 items-baseline">
              <div class="col-span-2 display text-3xl font-normal text-[color:var(--color-paper)]">{p.data.name}</div>
              <div class="col-span-8 serif text-lg text-[color:var(--color-ink-300)] group-hover:text-[color:var(--color-paper)] transition-colors">{p.data.tagline}</div>
              <div class="col-span-2 flex items-center justify-end gap-3">
                <span class="smallcaps text-[color:var(--color-amber-400)]">{p.data.status}</span>
                <span class="text-[color:var(--color-ink-300)] group-hover:text-[color:var(--color-amber-400)] group-hover:translate-x-0.5 transition-all" aria-hidden>→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="absolute bottom-0 left-0 right-0 opacity-30 rotate-180">
      <Meander tone="amber" />
    </div>
  </section>

  <!-- PRESS -->
  <section id="news" class="border-t hairline">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
      <div class="flex items-end justify-between mb-14 flex-wrap gap-4">
        <div>
          <SectionEyebrow letter="ΙV" label="In the press" />
          <h2 class="display text-4xl md:text-6xl font-normal tracking-tight text-[color:var(--color-ink-900)] leading-[1.05]">
            Where the <em class="italic text-[color:var(--color-amber-600)]">work shows up.</em>
          </h2>
        </div>
        <a href="/news" class="sans text-sm font-medium text-[color:var(--color-ink-900)] hover:text-[color:var(--color-amber-600)]">All press & seminars →</a>
      </div>

      <ul class="border-t hairline">
        {press.map((p) => (
          <li class="border-b hairline">
            <a
              href={p.data.url ?? "/news"}
              target={p.data.url ? "_blank" : undefined}
              rel="noopener"
              class="py-7 grid grid-cols-12 gap-4 items-baseline group"
            >
              <div class="col-span-12 md:col-span-2 smallcaps text-[color:var(--color-ink-500)]">{formatPressDate(p.data.date)}</div>
              <div class="col-span-12 md:col-span-2 display italic text-base text-[color:var(--color-amber-600)] leading-snug">{p.data.publication}</div>
              <div class="col-span-11 md:col-span-7 display text-2xl md:text-3xl font-normal text-[color:var(--color-ink-900)] leading-snug group-hover:text-[color:var(--color-amber-600)] transition-colors">{p.data.title}</div>
              <div class="col-span-1 text-right text-[color:var(--color-ink-300)] group-hover:text-[color:var(--color-amber-600)] group-hover:translate-x-0.5 transition-all" aria-hidden>↗</div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PARTNERS / CTA -->
  <section id="contact" class="border-t hairline bg-[color:var(--color-paper-2)]">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24 grid md:grid-cols-2 gap-16">
      <div>
        <SectionEyebrow letter="V" label="Work with us" />
        <h2 class="display text-4xl md:text-6xl font-normal tracking-tight text-[color:var(--color-ink-900)] leading-[1.05] mb-6">
          Have a corpus <em class="italic text-[color:var(--color-amber-600)]">too big to read?</em>
        </h2>
        <p class="serif text-xl text-[color:var(--color-ink-700)] leading-[1.55] mb-8 max-w-xl">
          We partner with research groups, the NHS, charities, and industry to
          build custom text-mining pipelines, from prototype to production.
        </p>
        <a
          href="mailto:nactem@manchester.ac.uk"
          class="inline-flex items-center gap-2 sans bg-[color:var(--color-ink-900)] text-[color:var(--color-paper)] rounded-full px-6 py-3 text-sm font-medium hover:bg-[color:var(--color-amber-600)] transition-colors"
        >
          Start a conversation <span aria-hidden>→</span>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-px bg-[color:var(--color-ink-100)] border hairline rounded-2xl overflow-hidden">
        {partners.map(([name, role]) => (
          <div class="bg-[color:var(--color-paper)] p-6">
            <div class="display text-xl font-normal text-[color:var(--color-ink-900)] leading-snug">{name}</div>
            <div class="smallcaps text-[color:var(--color-ink-500)] mt-2">{role}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
