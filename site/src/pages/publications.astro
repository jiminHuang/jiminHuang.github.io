---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Meander from "../components/Meander.astro";
import SectionEyebrow from "../components/SectionEyebrow.astro";

const pubs = (await getCollection("publications")).sort((a, b) =>
  (b.data.year ?? 0) - (a.data.year ?? 0) ||
  a.data.title.localeCompare(b.data.title),
);

const total = pubs.length;
const peopleCount = new Set(pubs.flatMap((p) => p.data.authors)).size;
const allYears = [...new Set(pubs.map((p) => p.data.year ?? 0))].filter((y) => y > 0).sort((a, b) => b - a);
const yearRange = allYears.length ? `${allYears[allYears.length - 1]}–${allYears[0]}` : "—";

const aigaionAll = "https://www.nactem.ac.uk/aigaion2/index.php/publications.html";

const typeMeta: Record<string, { label: string; fg: string; bg: string }> = {
  conference: { label: "Conference", fg: "var(--color-amber-600)", bg: "var(--color-amber-100)" },
  workshop:   { label: "Workshop",   fg: "#b85a2e",                 bg: "var(--color-paper-2)" },
  journal:    { label: "Journal",    fg: "var(--color-ink-900)",    bg: "var(--color-ink-100)" },
  preprint:   { label: "Preprint",   fg: "var(--color-ink-500)",    bg: "var(--color-paper-2)" },
  thesis:     { label: "Thesis",     fg: "var(--color-ink-700)",    bg: "var(--color-paper-2)" },
  other:      { label: "Other",      fg: "var(--color-ink-500)",    bg: "var(--color-paper-2)" },
};

const typeCounts = Object.fromEntries(
  Object.keys(typeMeta).map((t) => [t, pubs.filter((p) => p.data.venueType === t).length]),
) as Record<string, number>;
---

<Layout
  title="Publications — NaCTeM"
  description="The full NaCTeM bibliography — every paper since 2004, filterable by year, type, and author."
>
  <!-- HERO -->
  <section class="relative overflow-hidden paper-grain border-b hairline">
    <div class="absolute inset-0 -z-10">
      <div
        class="absolute -top-40 -right-40 w-[640px] h-[640px] rounded-full blur-3xl opacity-[0.18]"
        style="background: radial-gradient(closest-side, var(--color-amber-400), transparent 70%)"
      ></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-16 pb-16">
      <nav class="sans text-sm text-[color:var(--color-ink-500)] mb-10">
        <a href="/" class="hover:text-[color:var(--color-amber-600)]">Home</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-[color:var(--color-ink-700)]">Publications</span>
      </nav>

      <SectionEyebrow letter="Β" label="Bibliography" />

      <h1 class="antique text-[clamp(2.6rem,5.6vw,5rem)] font-normal leading-[1.04] tracking-[-0.01em] text-[color:var(--color-ink-900)] max-w-4xl mb-8">
        Two decades of <em class="italic text-[color:var(--color-amber-600)]">text-mining research</em> in print.
      </h1>

      <p class="serif text-xl md:text-2xl text-[color:var(--color-ink-700)] leading-[1.55] max-w-3xl">
        Every NaCTeM paper since 2004, mirrored from our Aigaion database.
        Filter by year, venue type, or author below.
      </p>

      <div class="mt-14 grid grid-cols-3 gap-px bg-[color:var(--color-ink-100)] border hairline rounded-2xl overflow-hidden max-w-2xl">
        <div class="bg-[color:var(--color-paper)] p-5">
          <div class="antique text-4xl text-[color:var(--color-ink-900)] leading-none">{total}</div>
          <div class="mt-2 smallcaps text-[color:var(--color-ink-500)]">Papers</div>
        </div>
        <div class="bg-[color:var(--color-paper)] p-5">
          <div class="antique text-4xl text-[color:var(--color-ink-900)] leading-none">{yearRange}</div>
          <div class="mt-2 smallcaps text-[color:var(--color-ink-500)]">Year range</div>
        </div>
        <div class="bg-[color:var(--color-paper)] p-5">
          <div class="antique text-4xl text-[color:var(--color-ink-900)] leading-none">{peopleCount}</div>
          <div class="mt-2 smallcaps text-[color:var(--color-ink-500)]">Unique authors</div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-6 opacity-50">
      <Meander tone="ink" />
    </div>
  </section>

  <!-- CONTROLS -->
  <section class="border-b hairline sticky top-20 z-30 bg-[color:var(--color-paper)]/95 backdrop-blur" id="pub-controls">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-6 grid lg:grid-cols-[1fr_auto] gap-4 items-end">
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center border hairline rounded-full px-4 py-2 gap-2 bg-[color:var(--color-paper-2)]">
          <span aria-hidden class="text-[color:var(--color-ink-500)]">⌕</span>
          <input
            id="pub-search"
            type="search"
            placeholder="Search title or author…"
            class="bg-transparent outline-none text-sm w-64 placeholder-[color:var(--color-ink-500)]"
          />
        </div>

        <div class="flex items-center gap-2 sans text-xs">
          <span class="smallcaps text-[color:var(--color-ink-500)]">Type</span>
          {Object.entries(typeMeta).map(([key, m]) => (
            <button
              type="button"
              data-type-filter={key}
              class="pub-type-btn border hairline rounded-full px-2.5 py-1 transition-colors"
              style={`color: ${m.fg};`}
            >{m.label} <span class="opacity-60">{typeCounts[key]}</span></button>
          ))}
        </div>
      </div>

      <div class="flex items-center gap-3 sans text-sm">
        <label class="smallcaps text-[color:var(--color-ink-500)]" for="pub-sort">Sort</label>
        <select
          id="pub-sort"
          class="border hairline rounded-full px-3 py-1.5 bg-[color:var(--color-paper)]"
        >
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="title">Title A→Z</option>
        </select>
      </div>
    </div>

    <!-- Year filter row -->
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-5 -mt-2 flex flex-wrap gap-1.5 sans text-xs items-center" id="pub-year-row">
      <span class="smallcaps text-[color:var(--color-ink-500)] mr-2">Year</span>
      <button type="button" data-year-all class="pub-year-btn border hairline rounded-full px-2.5 py-1 tabular-nums">All</button>
      {allYears.map((y) => (
        <button
          type="button"
          data-year={y}
          class="pub-year-btn border hairline rounded-full px-2.5 py-1 tabular-nums"
        >{y}</button>
      ))}
    </div>
  </section>

  <!-- RESULTS -->
  <section>
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-12">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-4">
        <div class="serif text-lg text-[color:var(--color-ink-700)]" id="pub-result-count"></div>
        <div class="sans text-xs text-[color:var(--color-ink-500)]">Showing <span id="pub-shown">0</span> of <span id="pub-shown-total">0</span></div>
      </div>

      <ul id="pub-list" class="space-y-10">
        {pubs.map((p, idx) => {
          const t = typeMeta[p.data.venueType ?? "other"];
          const authorPairs = p.data.authors.map((a, i) => ({
            name: a,
            slug: p.data.authorSlugs?.[i] || "",
          }));
          // Build a BibTeX entry string
          const bibtexType = (p.data.pubType ?? "Misc").toLowerCase();
          const bibtexKey = p.data.bibtexKey || `nactem:${p.data.aigaionId ?? idx}`;
          const fields: [string, string][] = [];
          fields.push(["author", p.data.authors.join(" and ")]);
          fields.push(["title", p.data.title]);
          if (p.data.venue) {
            const k = bibtexType === "article" ? "journal" : "booktitle";
            fields.push([k, p.data.venue]);
          }
          if (p.data.year) fields.push(["year", String(p.data.year)]);
          if (p.data.pages) fields.push(["pages", p.data.pages]);
          if (p.data.doi) fields.push(["doi", p.data.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//, "")]);
          if (p.data.url) fields.push(["url", p.data.url]);
          const bibtex = `@${bibtexType}{${bibtexKey},\n` +
            fields.map(([k, v]) => `  ${k} = {${v}}`).join(",\n") +
            "\n}";
          return (
            <li
              class="pub-item grid grid-cols-[80px_1fr] md:grid-cols-[110px_1fr] gap-x-6 gap-y-3"
              data-year={p.data.year ?? ""}
              data-type={p.data.venueType ?? "other"}
              data-title={p.data.title.toLowerCase()}
              data-authors={p.data.authors.join(" ").toLowerCase()}
              data-author-slugs={(p.data.authorSlugs ?? []).filter(Boolean).join(" ")}
              data-idx={idx}
              data-pub-index
            >
              <div class="flex flex-col items-start gap-3">
                <div class="antique text-3xl md:text-4xl text-[color:var(--color-ink-900)] leading-none tabular-nums">{p.data.year ?? "—"}</div>
                <span
                  class="smallcaps rounded-full px-2.5 py-1 border hairline"
                  style={`color: ${t.fg}; background: ${t.bg};`}
                >{t.label}</span>
              </div>

              <div>
                <div class="display text-xl md:text-2xl text-[color:var(--color-ink-900)] leading-snug mb-2">
                  {p.data.url || p.data.doi ? (
                    <a
                      href={p.data.url ?? p.data.doi!}
                      target="_blank"
                      rel="noopener"
                      class="hover:text-[color:var(--color-amber-600)] transition-colors"
                    >{p.data.title}</a>
                  ) : (
                    p.data.title
                  )}
                </div>

                {p.data.venueShort && (
                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <span
                      class="display italic text-base text-[color:var(--color-amber-600)] border-l-2 pl-3"
                      style="border-color: var(--color-amber-500);"
                    >{p.data.venueShort}</span>
                  </div>
                )}

                <div class="serif italic text-sm text-[color:var(--color-ink-500)] leading-snug mb-3">
                  {authorPairs.map((a, i) => (
                    <>
                      {a.slug ? (
                        <a
                          href={`/people/${a.slug}`}
                          class="hover:text-[color:var(--color-amber-600)] transition-colors"
                        >{a.name}</a>
                      ) : (
                        <span>{a.name}</span>
                      )}
                      {i < authorPairs.length - 1 && ", "}
                    </>
                  ))}
                </div>

                {p.data.venue && p.data.venue !== p.data.venueShort && (
                  <div class="serif text-sm text-[color:var(--color-ink-700)] leading-snug mb-3">{p.data.venue}</div>
                )}

                {p.data.keywords && p.data.keywords.length > 0 && (
                  <ul class="flex flex-wrap gap-1.5 mb-3">
                    {p.data.keywords.map((k) => (
                      <li class="sans text-[10px] uppercase tracking-wider text-[color:var(--color-ink-500)] bg-[color:var(--color-paper-2)] border hairline rounded-full px-2 py-0.5">{k}</li>
                    ))}
                  </ul>
                )}

                {p.data.abstract && (
                  <details class="mb-3 group/abs">
                    <summary class="cursor-pointer sans text-xs text-[color:var(--color-ink-500)] hover:text-[color:var(--color-ink-900)] inline-flex items-center gap-1">
                      <span class="group-open/abs:hidden">▸ Show abstract</span>
                      <span class="hidden group-open/abs:inline">▾ Hide abstract</span>
                    </summary>
                    <p class="mt-2 serif text-sm text-[color:var(--color-ink-700)] leading-[1.6] border-l-2 pl-4" style="border-color: var(--color-ink-100)">{p.data.abstract}</p>
                  </details>
                )}

                <details class="mb-3 group/bib">
                  <summary class="cursor-pointer sans text-xs text-[color:var(--color-ink-500)] hover:text-[color:var(--color-ink-900)] inline-flex items-center gap-1">
                    <span class="group-open/bib:hidden">▸ BibTeX</span>
                    <span class="hidden group-open/bib:inline">▾ BibTeX</span>
                  </summary>
                  <div class="mt-2 relative">
                    <button
                      type="button"
                      class="bibtex-copy absolute top-2 right-2 sans text-[10px] uppercase tracking-wider text-[color:var(--color-ink-500)] bg-[color:var(--color-paper)] border hairline rounded px-2 py-1 hover:bg-[color:var(--color-amber-100)] hover:text-[color:var(--color-amber-600)] transition-colors"
                    >Copy</button>
                    <pre class="bg-[color:var(--color-paper-2)] border hairline rounded p-4 text-xs text-[color:var(--color-ink-900)] overflow-x-auto font-mono leading-relaxed whitespace-pre">{bibtex}</pre>
                  </div>
                </details>


                <div class="flex flex-wrap gap-2 sans text-xs">
                  {p.data.pdfUrl && (
                    <a href={p.data.pdfUrl} target="_blank" rel="noopener" class="border hairline rounded-full px-3 py-1.5 bg-[color:var(--color-amber-100)] text-[color:var(--color-amber-600)] border-[color:var(--color-amber-500)] hover:bg-[color:var(--color-amber-500)] hover:text-[color:var(--color-paper)] transition-colors font-medium">PDF ↓</a>
                  )}
                  {p.data.doi && (
                    <a href={p.data.doi} target="_blank" rel="noopener" class="border hairline rounded-full px-3 py-1.5 text-[color:var(--color-ink-700)] hover:border-[color:var(--color-ink-900)] hover:bg-[color:var(--color-paper-2)] transition-colors">DOI ↗</a>
                  )}
                  {p.data.url && (
                    <a href={p.data.url} target="_blank" rel="noopener" class="border hairline rounded-full px-3 py-1.5 text-[color:var(--color-ink-700)] hover:border-[color:var(--color-ink-900)] hover:bg-[color:var(--color-paper-2)] transition-colors">URL ↗</a>
                  )}
                  {p.data.aigaionId && (
                    <a
                      href={`https://www.nactem.ac.uk/aigaion2/index.php/publications/show/${p.data.aigaionId}`}
                      target="_blank"
                      rel="noopener"
                      class="border hairline rounded-full px-3 py-1.5 text-[color:var(--color-ink-500)] hover:border-[color:var(--color-ink-900)] hover:text-[color:var(--color-ink-900)] hover:bg-[color:var(--color-paper-2)] transition-colors"
                    >BibTeX ↗</a>
                  )}
                  {p.data.pages && (
                    <span class="sans text-xs text-[color:var(--color-ink-500)] self-center ml-2">pp. {p.data.pages}</span>
                  )}
                </div>
              </div>
            </li>
          );
        })}
      </ul>

      <!-- Pagination -->
      <nav class="mt-12 flex items-center justify-between gap-4 sans text-sm" id="pub-pagination" style="display:none">
        <button type="button" id="pub-prev" class="border hairline rounded-full px-4 py-2 text-[color:var(--color-ink-700)] hover:bg-[color:var(--color-paper-2)] disabled:opacity-40 disabled:cursor-not-allowed">← Previous</button>
        <div id="pub-pagelabel" class="smallcaps text-[color:var(--color-ink-500)] tabular-nums"></div>
        <button type="button" id="pub-next" class="border hairline rounded-full px-4 py-2 text-[color:var(--color-ink-700)] hover:bg-[color:var(--color-paper-2)] disabled:opacity-40 disabled:cursor-not-allowed">Next →</button>
      </nav>

      <div id="pub-empty" class="serif italic text-lg text-[color:var(--color-ink-500)] py-16 text-center hidden">
        No papers match these filters.
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[color:var(--color-ink-950)] text-[color:var(--color-paper)] relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 opacity-30">
      <Meander tone="amber" />
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 grid md:grid-cols-[2fr_1fr] gap-10 items-end">
      <div>
        <SectionEyebrow letter="Ω" label="The original" tone="dark" />
        <h2 class="display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05]">
          Browse the <em class="italic text-[color:var(--color-amber-400)]">original Aigaion</em>.
        </h2>
        <p class="serif text-lg text-[color:var(--color-ink-300)] leading-[1.55] mt-6 max-w-xl">
          Each paper here links back to its Aigaion record via the BibTeX
          button. The source-of-truth database lives at nactem.ac.uk.
        </p>
      </div>
      <a
        href={aigaionAll}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 sans bg-[color:var(--color-paper)] text-[color:var(--color-ink-900)] rounded-full px-6 py-3 text-sm font-medium hover:bg-[color:var(--color-amber-400)] transition-colors w-fit"
      >
        Open Aigaion <span aria-hidden>↗</span>
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
(() => {
  const PAGE = 25;
  const list = document.getElementById("pub-list");
  if (!list) return;
  const items = [...list.querySelectorAll("[data-pub-index]")];
  const searchEl = document.getElementById("pub-search");
  const sortEl = document.getElementById("pub-sort");
  const yearRow = document.getElementById("pub-year-row");
  const typeBtns = [...document.querySelectorAll(".pub-type-btn")];
  const resultEl = document.getElementById("pub-result-count");
  const shownEl = document.getElementById("pub-shown");
  const shownTotalEl = document.getElementById("pub-shown-total");
  const paginationEl = document.getElementById("pub-pagination");
  const prevBtn = document.getElementById("pub-prev");
  const nextBtn = document.getElementById("pub-next");
  const pageLabel = document.getElementById("pub-pagelabel");
  const emptyEl = document.getElementById("pub-empty");

  let state = {
    search: "",
    types: new Set(),       // empty = all
    year: null,             // null = all
    sort: "newest",
    page: 0,
    authorSlug: null,       // null = all
  };

  // Pre-compute item meta for sorting
  const meta = items.map((el) => ({
    el,
    year: parseInt(el.dataset.year || "0", 10),
    type: el.dataset.type,
    title: el.dataset.title,
    authors: el.dataset.authors,
    authorSlugs: (el.dataset.authorSlugs || "").split(" ").filter(Boolean),
  }));

  // URL ?author=<slug> presets the filter
  const params = new URLSearchParams(location.search);
  if (params.get("author")) {
    state.authorSlug = params.get("author");
    // Find author name from one of the items for the result label
  }
  if (params.get("year")) {
    const y = parseInt(params.get("year"), 10);
    if (y > 0) state.year = y;
  }

  function applyFilters() {
    const q = state.search.trim().toLowerCase();
    return meta.filter((m) => {
      if (state.types.size > 0 && !state.types.has(m.type)) return false;
      if (state.year != null && m.year !== state.year) return false;
      if (state.authorSlug && !m.authorSlugs.includes(state.authorSlug)) return false;
      if (q && !m.title.includes(q) && !m.authors.includes(q)) return false;
      return true;
    });
  }

  function applySort(filtered) {
    const sorted = filtered.slice();
    if (state.sort === "newest") sorted.sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
    else if (state.sort === "oldest") sorted.sort((a, b) => a.year - b.year || a.title.localeCompare(b.title));
    else if (state.sort === "title") sorted.sort((a, b) => a.title.localeCompare(b.title));
    return sorted;
  }

  function render() {
    const filtered = applyFilters();
    const sorted = applySort(filtered);
    const total = sorted.length;

    // Hide everything first
    for (const m of meta) m.el.style.display = "none";

    if (total === 0) {
      emptyEl.classList.remove("hidden");
      paginationEl.style.display = "none";
    } else {
      emptyEl.classList.add("hidden");
    }

    const pages = Math.max(1, Math.ceil(total / PAGE));
    if (state.page >= pages) state.page = 0;

    // Reorder + show current page
    const start = state.page * PAGE;
    const end = Math.min(start + PAGE, total);
    for (let i = start; i < end; i++) {
      const m = sorted[i];
      m.el.style.display = "";
      list.appendChild(m.el); // re-append to reorder
    }

    shownEl.textContent = total === 0 ? "0" : `${start + 1}–${end}`;
    shownTotalEl.textContent = String(total);
    resultEl.textContent = describeFilters(total);

    if (total > PAGE) {
      paginationEl.style.display = "flex";
      pageLabel.textContent = `Page ${state.page + 1} of ${pages}`;
      prevBtn.disabled = state.page === 0;
      nextBtn.disabled = state.page >= pages - 1;
    } else {
      paginationEl.style.display = "none";
    }
  }

  function describeFilters(n) {
    const parts = [];
    if (state.authorSlug) parts.push(`author ${state.authorSlug}`);
    if (state.types.size) parts.push([...state.types].map((t) => t).join(" · "));
    if (state.year != null) parts.push(String(state.year));
    if (state.search) parts.push(`"${state.search}"`);
    const filterText = parts.length ? ` matching ${parts.join(" · ")}` : "";
    return `${n} ${n === 1 ? "paper" : "papers"}${filterText}`;
  }

  function updateYearButtons() {
    [...yearRow.querySelectorAll(".pub-year-btn")].forEach((b) => {
      const yr = b.dataset.year ? parseInt(b.dataset.year, 10) : null;
      const active = (state.year === null && b.hasAttribute("data-year-all")) ||
                     (state.year != null && yr === state.year);
      b.style.background = active ? "var(--color-ink-900)" : "";
      b.style.color = active ? "var(--color-paper)" : "";
      b.style.borderColor = active ? "var(--color-ink-900)" : "";
    });
  }

  function updateTypeButtons() {
    for (const b of typeBtns) {
      const active = state.types.has(b.dataset.typeFilter);
      b.style.background = active ? "var(--color-ink-900)" : "";
      b.style.color = active ? "var(--color-paper)" : b.style.color;
      b.style.borderColor = active ? "var(--color-ink-900)" : "";
    }
  }

  searchEl.addEventListener("input", (e) => {
    state.search = e.target.value;
    state.page = 0;
    render();
  });
  sortEl.addEventListener("change", (e) => {
    state.sort = e.target.value;
    state.page = 0;
    render();
  });
  yearRow.addEventListener("click", (e) => {
    const btn = e.target.closest(".pub-year-btn");
    if (!btn) return;
    if (btn.hasAttribute("data-year-all")) {
      state.year = null;
    } else {
      const yr = parseInt(btn.dataset.year, 10);
      state.year = state.year === yr ? null : yr;
    }
    state.page = 0;
    updateYearButtons();
    render();
  });
  for (const b of typeBtns) {
    b.addEventListener("click", () => {
      const key = b.dataset.typeFilter;
      if (state.types.has(key)) state.types.delete(key); else state.types.add(key);
      state.page = 0;
      updateTypeButtons();
      render();
    });
  }
  prevBtn.addEventListener("click", () => {
    if (state.page > 0) { state.page--; render(); window.scrollTo({ top: list.offsetTop - 240, behavior: "smooth" }); }
  });
  nextBtn.addEventListener("click", () => {
    state.page++;
    render();
    window.scrollTo({ top: list.offsetTop - 240, behavior: "smooth" });
  });

  updateYearButtons();
  updateTypeButtons();
  render();

  // BibTeX copy buttons (delegated)
  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".bibtex-copy");
    if (!btn) return;
    const pre = btn.parentElement?.querySelector("pre");
    if (!pre) return;
    const text = pre.textContent || "";
    navigator.clipboard.writeText(text).then(() => {
      const orig = btn.textContent;
      btn.textContent = "Copied ✓";
      btn.style.color = "var(--color-amber-600)";
      setTimeout(() => {
        btn.textContent = orig;
        btn.style.color = "";
      }, 1500);
    });
  });
})();
</script>
