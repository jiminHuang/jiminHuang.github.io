---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Meander from "../../components/Meander.astro";
import SectionEyebrow from "../../components/SectionEyebrow.astro";

const corpora = await getCollection("corpora");

const CATEGORIES: Array<{ key: string; greek: string; label: string; blurb: string }> = [
  { key: "Biomedical events",    greek: "Α", label: "Biomedical events",     blurb: "Corpora annotated for events, relations, and meta-knowledge over molecular biology." },
  { key: "Anatomy & physiology", greek: "Β", label: "Anatomy & physiology",  blurb: "Annotation of organs, tissues, and cell types — backbone of the AnatomyTagger family." },
  { key: "Disease-specific",     greek: "Γ", label: "Disease-specific",      blurb: "Corpora curated around a single condition or domain: COPD, ChEBI, phenotypes, exposure." },
  { key: "Terminologies",        greek: "Δ", label: "Terminologies & lexica",blurb: "Reference vocabularies for downstream NER and search." },
  { key: "Other",                greek: "Ε", label: "Other resources",       blurb: "Misinformation, multilingual, readability, and metabolite corpora." },
];

const sections = CATEGORIES.map((c) => ({
  ...c,
  items: corpora
    .filter((x) => x.data.category === c.key)
    .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.name.localeCompare(b.data.name)),
})).filter((c) => c.items.length > 0);
---

<Layout
  title="Resources — NaCTeM"
  description="Open corpora, terminologies, and lexica curated and released by NaCTeM."
>
  <!-- HERO -->
  <section class="relative overflow-hidden paper-grain border-b hairline">
    <div class="absolute inset-0 -z-10">
      <div
        class="absolute -top-40 -right-40 w-[640px] h-[640px] rounded-full blur-3xl opacity-[0.18]"
        style="background: radial-gradient(closest-side, var(--color-amber-400), transparent 70%)"
      ></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-16 pb-16">
      <nav class="sans text-sm text-[color:var(--color-ink-500)] mb-10">
        <a href="/" class="hover:text-[color:var(--color-amber-600)]">Home</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-[color:var(--color-ink-700)]">Resources</span>
      </nav>

      <SectionEyebrow letter="Ρ" label="Open data" />

      <h1 class="display text-[clamp(2.6rem,5.6vw,5rem)] font-normal leading-[1.04] tracking-[-0.01em] text-[color:var(--color-ink-900)] max-w-4xl mb-8">
        Corpora, <em class="italic text-[color:var(--color-amber-600)]">terminologies,</em> and the data the field trains on.
      </h1>

      <p class="serif text-xl md:text-2xl text-[color:var(--color-ink-700)] leading-[1.55] max-w-3xl">
        Two decades of annotation work — from the GENIA corpus that helped
        define biomedical NLP, through PHAEDRA for drug interactions, to
        recent corpora on occupational exposure and controllable readability.
        Most are free to download for research.
      </p>

      <div class="mt-14 grid grid-cols-3 gap-px bg-[color:var(--color-ink-100)] border hairline rounded-2xl overflow-hidden max-w-2xl">
        <div class="bg-[color:var(--color-paper)] p-5">
          <div class="antique text-4xl text-[color:var(--color-ink-900)] leading-none">{corpora.length}</div>
          <div class="mt-2 smallcaps text-[color:var(--color-ink-500)]">Corpora</div>
        </div>
        <div class="bg-[color:var(--color-paper)] p-5">
          <div class="antique text-4xl text-[color:var(--color-ink-900)] leading-none">{sections.length}</div>
          <div class="mt-2 smallcaps text-[color:var(--color-ink-500)]">Categories</div>
        </div>
        <div class="bg-[color:var(--color-paper)] p-5">
          <div class="antique text-4xl text-[color:var(--color-ink-900)] leading-none">
            {Math.min(...corpora.map((c) => c.data.year ?? 9999))}
          </div>
          <div class="mt-2 smallcaps text-[color:var(--color-ink-500)]">First release</div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-6 opacity-50">
      <Meander tone="ink" />
    </div>
  </section>

  <!-- CATEGORIES -->
  {sections.map((s, idx) => (
    <section class={`border-b hairline ${idx % 2 === 1 ? "bg-[color:var(--color-paper-2)]" : ""}`}>
      <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 mb-12 items-end">
          <div>
            <SectionEyebrow letter={s.greek} label={s.label} />
            <h2 class="display text-3xl md:text-5xl font-medium tracking-tight text-[color:var(--color-ink-900)] leading-[1.05]">
              {s.label}
            </h2>
          </div>
          <p class="serif text-lg text-[color:var(--color-ink-700)] leading-[1.55] max-w-2xl self-end">
            {s.blurb}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {s.items.map((c) => (
            <a
              href={`/resources/${c.id}`}
              class="group block border hairline rounded-xl p-6 bg-[color:var(--color-paper)] hover:border-[color:var(--color-ink-900)] hover:shadow-sm transition-all"
            >
              <div class="flex items-start justify-between mb-4 gap-3">
                <span class="smallcaps text-[color:var(--color-amber-600)] tabular-nums">{c.data.year ?? "—"}</span>
                <span class="text-[color:var(--color-ink-300)] group-hover:text-[color:var(--color-amber-600)] group-hover:translate-x-0.5 transition-all" aria-hidden>↗</span>
              </div>
              <div class="display text-2xl font-medium text-[color:var(--color-ink-900)] mb-2 group-hover:text-[color:var(--color-amber-600)] transition-colors">{c.data.name}</div>
              <p class="serif text-base text-[color:var(--color-ink-700)] leading-snug">{c.data.tagline}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="bg-[color:var(--color-ink-950)] text-[color:var(--color-paper)] relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 opacity-30">
      <Meander tone="amber" />
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 grid md:grid-cols-[2fr_1fr] gap-10 items-end">
      <div>
        <SectionEyebrow letter="Ω" label="Citing & licensing" tone="dark" />
        <h2 class="display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05]">
          Free to use, <em class="italic text-[color:var(--color-amber-400)]">please cite.</em>
        </h2>
        <p class="serif text-lg text-[color:var(--color-ink-300)] leading-[1.55] mt-6 max-w-xl">
          Every corpus page lists its release paper. Most ship under
          research-friendly licences; a few require a short licence agreement.
          If something isn't clear, email Paul Thompson.
        </p>
      </div>
      <a
        href="mailto:paul.thompson@manchester.ac.uk"
        class="inline-flex items-center gap-2 sans bg-[color:var(--color-paper)] text-[color:var(--color-ink-900)] rounded-full px-6 py-3 text-sm font-medium hover:bg-[color:var(--color-amber-400)] transition-colors w-fit"
      >
        Ask about a corpus <span aria-hidden>→</span>
      </a>
    </div>
  </section>
</Layout>
